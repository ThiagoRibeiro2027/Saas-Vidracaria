# Copie este arquivo para .env.local e preencha os valores.
#
#   cp .env.example .env.local
#
# O .env.local NAO e versionado (.gitignore: .env*). Cada maquina tem o seu,
# apontando para o MESMO projeto Supabase na nuvem — e assim que as maquinas
# compartilham os dados. Nao use `supabase start` (banco local) se voce
# trabalha em mais de uma maquina: os bancos divergem em silencio.
#
# Onde achar os valores: Supabase > Project Settings > API.

# ---------------------------------------------------------------
# Obrigatorias — sem elas o app nao funciona.
# Sao lidas com `!` (sem validacao): se faltar uma, o erro nao aparece na
# subida, e sim na primeira chamada, como "Invalid URL" ou
# "supabaseKey is required".
# ---------------------------------------------------------------

# URL base do projeto, SEM /rest/v1 no final — o supabase-js acrescenta o
# caminho sozinho. Formato: https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Chave publica. E entregue ao navegador de qualquer visitante; quem protege
# os dados e o RLS, nao ela.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SEGREDO. Ignora o RLS por completo — le e escreve qualquer linha de
# qualquer empresa. Nunca no navegador, nunca em commit, nunca em chat.
# Usada so por src/lib/supabase/admin.ts (marcado "server-only").
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------
# Opcionais — `npm run dev` sobe sem elas.
# ---------------------------------------------------------------

# Protege as 3 rotas em /api/cron/ (ver vercel.json). Sem ela, todas
# respondem 401 — seguro, mas os crons nao rodam.
CRON_SECRET=

# Envio de e-mail: alertas de seguranca e notificacoes.
# Sem dominio verificado no Resend, so entrega para o e-mail dono da conta,
# entao SECURITY_ALERT_EMAIL precisa ser esse mesmo endereco.
RESEND_API_KEY=
SECURITY_ALERT_EMAIL=

# Apenas os scripts de backup/restore e os testes de RLS.
# Default quando ausente: postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_URL=
